// The device images are linked relocatably and handed to the host link, which
// creates the SHC fat binary and the code registering it with the runtime.

// RUN: %clang -x shc --target=x86_64-unknown-linux-gnu %s -o %t.out \
// RUN:   --offload-link -Wl,--unresolved-symbols=ignore-all
// RUN: llvm-readobj --sections %t.out | FileCheck %s
// RUN: llvm-nm %t.out | FileCheck %s --check-prefix=SYM

// CHECK-DAG: Name: .shc_fatbin
// CHECK-DAG: Name: .shcFatBinSegment
// CHECK-DAG: Name: .init_array

// SHC is always relocatable, so the host objects leave only offloading entries
// behind and the fat binary is registered by a constructor the linker wrapper
// emits at link time.
// SYM-DAG: t .shc.fatbin_reg
// SYM-DAG: t .shc.fatbin_unreg
// SYM-DAG: t .shc.globals_reg
// SYM-DAG: b .shc.binary_handle

__global__ void kern(int *x) { *x = 1; }

void host(int *x) { kern<<<1, 1>>>(x); }
