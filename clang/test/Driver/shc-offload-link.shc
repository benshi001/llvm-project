// The device images are linked relocatably and handed to the host link, which
// defines the `__shc_fatbin` symbol the host objects reference.

// RUN: %clang -x shc --target=x86_64-unknown-linux-gnu %s -o %t.out \
// RUN:   --offload-link -Wl,--unresolved-symbols=ignore-all
// RUN: llvm-readobj --sections %t.out | FileCheck %s
// CHECK: Name: .shc_fatbin

__global__ void kern(int *x) { *x = 1; }

void host(int *x) { kern<<<1, 1>>>(x); }
