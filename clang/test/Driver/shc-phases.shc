// Test that the SHC input type is recognized and that it goes through the
// expected host/device offloading phases.

// RUN: %clang -x shc --target=x86_64-unknown-linux-gnu -ccc-print-phases -c %s 2>&1 \
// RUN:   | FileCheck %s

// The host compilation.
// CHECK: [[P0:[0-9]+]]: input, "{{.*}}shc-phases.shc", [[T:shc]], (host-shc)
// CHECK: [[P1:[0-9]+]]: preprocessor, {[[P0]]}, [[T]]-cpp-output, (host-shc)
// CHECK: [[P2:[0-9]+]]: compiler, {[[P1]]}, ir, (host-shc)

// The device compilation for the offload target.
// CHECK: [[D0:[0-9]+]]: input, "{{.*}}shc-phases.shc", [[T]], (device-shc)
// CHECK: [[D1:[0-9]+]]: preprocessor, {[[D0]]}, [[T]]-cpp-output, (device-shc)
// CHECK: [[D2:[0-9]+]]: compiler, {[[D1]]}, ir, (device-shc)
// CHECK: [[D3:[0-9]+]]: backend, {[[D2]]}, assembler, (device-shc)
// CHECK: [[D4:[0-9]+]]: assembler, {[[D3]]}, object, (device-shc)
// CHECK: [[D5:[0-9]+]]: offload, "device-shc (riscv32-unknown-unknown-elf)" {[[D4]]}, object
// SHC is always relocatable, so the device code is only packaged here and
// carried to the final link, where the linker wrapper links it into the SHC
// fat binary.
// CHECK: [[D6:[0-9]+]]: llvm-offload-binary, {[[D5]]}, image, (device-shc)

// The device image is fed back into the host compilation.
// CHECK: [[P3:[0-9]+]]: offload, "host-shc (x86_64-unknown-linux-gnu)" {[[P2]]}, "device-shc (x86_64-unknown-linux-gnu)" {[[D6]]}, ir
// CHECK: [[P4:[0-9]+]]: backend, {[[P3]]}, assembler, (host-shc)
// CHECK: [[P5:[0-9]+]]: assembler, {[[P4]]}, object, (host-shc)

// The .shc extension alone must select the SHC input type, without -x.
//
// RUN: %clang --target=x86_64-unknown-linux-gnu -ccc-print-phases -c %s 2>&1 \
// RUN:   | FileCheck %s

// SHC is handed over to cc1 as "-x shc".
//
// RUN: %clang -### -x shc --target=x86_64-unknown-linux-gnu -c %s 2>&1 \
// RUN:   | FileCheck -check-prefix=CC1 %s
// CC1: "-cc1"
// CC1-SAME: "-x" "shc"

// Preprocessed SHC sources use the shc-cpp-output type.
//
// RUN: %clang -### -x shc-cpp-output --target=x86_64-unknown-linux-gnu -c %s 2>&1 \
// RUN:   | FileCheck -check-prefix=PPOUT %s
// PPOUT: "-cc1"
// PPOUT-SAME: "-x" "shc-cpp-output"
